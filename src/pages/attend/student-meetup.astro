---
import CallToAction from '../../components/widgets/CallToAction.astro';
import Content from '../../components/widgets/Content.astro';
import Features2 from '../../components/widgets/Features2.astro';
import Hero from '../../components/widgets/Hero.astro';
import Testimonials from '../../components/widgets/Testimonials.astro';
import Layout from '../../layouts/PageLayout.astro';
import type { IconifyJSON, IconifyInfo, IconifyMetaData, IconifyChars } from '@iconify/types';
import {IconifyJSON} from "@iconify-json/flat-color-icons";
import Brands5 from "../../components/widgets/Brands5.astro";

const metadata = {
  title: 'Student Meetup',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Attend"
    title="Student Activities"
    subtitle="Events for students to meet peers, exchange ideas, and build lasting professional connections within the IWAENC community."
    actions={[
      { text: 'Sign-up here!', href: 'https://forms.office.com/e/FNgnsHPTAm' },
    ]}
  />

  <!-- Content Widget **************** -->

    <Features2
            title="Best Student Paper Award"
            subtitle=""
            tagline="More on the "
            columns={1}
            items={[
                {
                    title: '',
                    description: 'The IWAENC 2026 Technical Committee will present the Best Student Paper Award to recognize an outstanding student contribution to the conference. The selection will be based on originality, scientific merit, and the quality of writing and presentation. To be eligible, the paper must be presented by the candidate student. We gratefully acknowledge the generous support of <b>Mitsubishi Electric Research Laboratories (MERL)</b>, which sponsors this award.',
                    icon: '',
                },
            ]}
    >
    </Features2>

  <Content
    isReversed
    items={[
      {
        title: 'h. 1:00 PM - 3:00 PM - Student Networking Event',
        description:
          'Are you a student attending IWAENC? Join the Student Meetup, a dedicated networking event designed to help participants connect, exchange ideas, and build lasting collaborations.\n<br><br>' +
            'This informal gathering will feature a series of interactive activities and icebreakers to encourage participants to get to know one another, discuss their research interests, and foster new collaborations across institutions and research areas.\n' +
            'Whether you are attending IWAENC for the first time or returning to reconnect with colleagues, this is a great opportunity to expand your professional network and become part of the IWAENC student community.\n<br><br>' +
            'Students interested in participating are encouraged to register using the sign-up form. Additional information about the venue and the planned activities will be provided further ahead.<br><br>' +
          'We are thankful to <b>WSAudiology</b>, which sponsors this meetup.',
          icon: 'tabler:users',
      },
    ]}
    image={{
      src: '~/assets/images/cremona-campus.jpeg',
      alt: 'Cremona campus.',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Tuesday, Sept. 8<br>
      </h3>
    </Fragment>

      <Fragment slot="bg">
          <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
      </Fragment>
  </Content>

  <Brands5
      tagline="Student Activities"
      title="Patrons"
      subtitle="We thank our patrons for making the IWAENC 2026 student activities possible through their support."
      images={[
        {
          src: '~/assets/images/logos/WSA_Logo1.png',
          alt: 'WSAudiology',
        },
          {
              src: '~/assets/images/logos/merl_logo.png',
              alt: 'MERL',
          },
      ]}
  >
  </Brands5>

</Layout>
